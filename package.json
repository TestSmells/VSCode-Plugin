{
  "name": "test-smell-detector",
  "displayName": "Test Smell Detector",
  "description": "Analyze Java test files with TSDetect, inline diagnostics and Problems integration.",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Linters"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:java"
  ],
  "contributes": {
    "commands": [
      {
        "command": "testSmellDetector.analyzeCurrentFile",
        "title": "Test Smell Detector: Analyze Current File"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "testSmellDetector.analyzeCurrentFile",
          "when": "resourceExtname == .java",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Test Smell Detector",
      "properties": {
        "testSmellDetector.javaPath": {
          "type": "string",
          "default": "java",
          "description": "Path to Java executable (Java 11 or newer)."
        },
        "testSmellDetector.analyzeOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Analyze Java test files after save and when opened."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.6.0"
  }
}
