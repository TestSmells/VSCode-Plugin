{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:test-smell-detector:regression-corpus-results:v1",
  "title": "Shared tsDetect regression corpus results",
  "description": "Normalized expected results for Java source pairs analyzed by tsDetect.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "detector",
    "normalization",
    "cases"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "detector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "sourceCommit"
      ],
      "properties": {
        "name": {
          "const": "tsDetect"
        },
        "sourceCommit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "normalization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "smellOrder",
        "duplicates",
        "paths"
      ],
      "properties": {
        "smellOrder": {
          "const": "alphabetical"
        },
        "duplicates": {
          "const": "removed"
        },
        "paths": {
          "const": "repository-relative-posix"
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 10,
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "$defs": {
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "purpose",
        "framework",
        "testFile",
        "productionFile",
        "expected"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9]{2}-[a-z0-9-]+$"
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "framework": {
          "enum": [
            "junit4",
            "junit5"
          ]
        },
        "testFile": {
          "$ref": "#/$defs/javaPath"
        },
        "productionFile": {
          "$ref": "#/$defs/javaPath"
        },
        "expected": {
          "oneOf": [
            {
              "$ref": "#/$defs/success"
            },
            {
              "$ref": "#/$defs/error"
            }
          ]
        }
      }
    },
    "javaPath": {
      "type": "string",
      "pattern": "^cases/.+\\.java$"
    },
    "success": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "testMethods",
        "smells"
      ],
      "properties": {
        "status": {
          "const": "success"
        },
        "testMethods": {
          "type": "integer",
          "minimum": 0
        },
        "smells": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "category"
      ],
      "properties": {
        "status": {
          "const": "error"
        },
        "category": {
          "enum": [
            "malformed-input",
            "detector-failure",
            "missing-output",
            "invalid-output"
          ]
        },
        "messageContains": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
