{
  "name": "test-smell-detector",
  "displayName": "Test Smell Detector",
  "description": "Detect test smells in Java test files from Visual Studio Code.",
  "version": "0.0.1",
  "publisher": "testsmells",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/TestSmells/VSCode-Plugin.git"
  },
  "private": true,
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Linters"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:java"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "testSmellDetector.analyzeCurrentFile",
        "title": "Analyze Current File",
        "category": "Test Smell Detector"
      }
    ],
    "configuration": {
      "title": "Test Smell Detector",
      "properties": {
        "testSmellDetector.javaPath": {
          "type": "string",
          "default": "java",
          "description": "Java executable used to run the bundled tsDetect JAR."
        },
        "testSmellDetector.analyzeOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Automatically analyze saved Java test files and refresh their diagnostics."
        },
        "testSmellDetector.smells.assertionRoulette": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Report Assertion Roulette findings."
        },
        "testSmellDetector.smells.conditionalTestLogic": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Report Conditional Test Logic findings."
        },
        "testSmellDetector.smells.constructorInitialization": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Report Constructor Initialization findings."
        },
        "testSmellDetector.smells.defaultTest": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Report Default Test findings."
        },
        "testSmellDetector.smells.dependentTest": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Report Dependent Test findings."
        },
        "testSmellDetector.smells.duplicateAssert": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Report Duplicate Assert findings."
        },
        "testSmellDetector.smells.eagerTest": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Report Eager Test findings."
        },
        "testSmellDetector.smells.emptyTest": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Report Empty Test findings."
        },
        "testSmellDetector.smells.exceptionCatchingThrowing": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Report Exception Catching Throwing findings."
        },
        "testSmellDetector.smells.generalFixture": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Report General Fixture findings."
        },
        "testSmellDetector.smells.ignoredTest": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Report Ignored Test findings."
        },
        "testSmellDetector.smells.lazyTest": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Report Lazy Test findings."
        },
        "testSmellDetector.smells.magicNumberTest": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Report Magic Number Test findings."
        },
        "testSmellDetector.smells.mysteryGuest": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Report Mystery Guest findings."
        },
        "testSmellDetector.smells.redundantAssertion": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Report Redundant Assertion findings."
        },
        "testSmellDetector.smells.redundantPrint": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Report Redundant Print findings."
        },
        "testSmellDetector.smells.resourceOptimism": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Report Resource Optimism findings."
        },
        "testSmellDetector.smells.sensitiveEquality": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Report Sensitive Equality findings."
        },
        "testSmellDetector.smells.sleepyTest": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Report Sleepy Test findings."
        },
        "testSmellDetector.smells.unknownTest": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Report Unknown Test findings."
        },
        "testSmellDetector.smells.verboseTest": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Report Verbose Test findings."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "clean": "node scripts/clean-out.js",
    "compile": "npm run clean && tsc -p ./",
    "watch": "tsc -watch -p ./",
    "check": "tsc --noEmit -p ./",
    "test:preferences": "node --test test/smell-preferences.test.js",
    "test:corpus": "node scripts/run-regression-corpus.js",
    "package:vsix": "vsce package --out test-smell-detector.vsix"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^4.0.0",
    "typescript": "^5.7.2"
  }
}
